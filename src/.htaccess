# =====================================================================
# Success Learning — Apache / LiteSpeed rules for the Angular SPA build
# Copied to the site root (public_html) next to index.html by `ng build`.
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1. Canonical host: successlearning.in -> www.successlearning.in ---
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # --- 2. SPA fallback ---
  # Angular routes (/about, /courses/ielts-coaching, ...) are not real files
  # on disk. Without this the server answers 404. Anything that is not an
  # existing file or directory is served index.html with a 200 status, and the
  # Angular router then renders the right page.
  # A missing asset still gets a real 404 — serving index.html for a broken
  # image or script would hide the problem behind a 200.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|mjs|css|map|json|xml|txt|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot|pdf|mp4|webm)$ [NC]
  RewriteRule ^ /index.html [L]
</IfModule>

# --- 3. Caching ---
# Build output is content-hashed (main.<hash>.js), so it can be cached hard.
# index.html / robots.txt / sitemap.xml must stay fresh after every deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/webp              "access plus 6 months"
  ExpiresByType image/avif              "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- 4. Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 5. Correct content types ---
<IfModule mod_mime.c>
  AddType application/xml   .xml
  AddType text/plain        .txt
  AddType image/webp        .webp
  AddType image/avif        .avif
  AddType font/woff2        .woff2
</IfModule>
